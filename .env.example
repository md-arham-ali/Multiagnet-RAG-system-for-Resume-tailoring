# =============================================================================
# Environment template — copy to `.env` and fill in real values.
# `.env` is git-ignored; never commit real keys. All keys are read ONLY in
# config.py (see Instructions.md step 3: "Never hardcode keys anywhere else").
# =============================================================================

# ---- Test / cost mode ---------------------------------------------------------
# dev  -> every agent uses Groq Llama (cheap; for graph/behaviour testing)
# eval -> Document + Critic agents use Gemini Flash (quality testing only)
TEST_MODE=dev

# ---- Offline mode ------------------------------------------------------------
# USE_FAKE_LLM=1 runs the whole graph on a local fake LLM: no network, no keys,
# no spend. Wins over TEST_MODE and USE_OPENAI. Usually set per command
# (`USE_FAKE_LLM=1 python scripts/run_graph.py`) rather than left on here.
USE_FAKE_LLM=0

# ---- Provider override: run the whole system on OpenAI -----------------------
# USE_OPENAI=1 routes EVERY agent to OPENAI_MODEL (needs OPENAI_API_KEY below),
# ignoring the Groq/Gemini assignment above. Leave 0 for the default lanes.
# USE_FAKE_LLM=1 still overrides this for free offline structure testing.
USE_OPENAI=0
OPENAI_MODEL=gpt-4o-mini

# ---- Groq (JD Analysis, Profile, Matching, Verifier, Evaluation) -------------
# https://console.groq.com/keys
GROQ_API_KEY=
# Model name your key can list; the default may not exist on every account.
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Google AI Studio / Gemini (Document, Critic in eval mode) ---------------
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ---- Fallback providers (LiteLLM fallback chains — see Instructions Part 3) ---
# Groq lane:  Groq -> Cerebras -> OpenRouter :free
# Gemini lane: Gemini -> OpenRouter Gemini :free -> Groq 70B
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# ---- Local Ollama (optional local llama 3.3 70B fallback) --------------------
OLLAMA_BASE_URL=http://localhost:11434

# ---- OpenAI (required when USE_OPENAI=1; routes every agent to OPENAI_MODEL) --
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Langfuse (observability / tracing) --------------------------------------
# https://cloud.langfuse.com  (or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Postgres (target checkpointer, NOT the one in use) ----------------------
# The gates run on SqliteSaver at logs/checkpoints.sqlite (utils/checkpointer.py)
# and survive a restart already. This is the Build.md Postgres target; nothing
# reads it yet. Format: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic

# ---- Embeddings / reranking (local, free — sentence-transformers) ------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- Gemini daily budget guard (Instructions Part 4) -------------------------
# Soft alert at 80% of the 1,500/day free cap.
GEMINI_DAILY_LIMIT=1500
GEMINI_ALERT_THRESHOLD=1200

# ---- Frontend access control (bridge API auth) -------------------------------
# The one port the bridge API is served on. scripts/dev.py starts uvicorn here,
# the Vite proxy and scripts/smoke_backend.py both target it, so changing it
# moves all three together. Leave it unset for 8000. (The nginx image takes
# its own BACKEND_URL, default http://host.docker.internal:8000: set that too if
# you change the port and run the frontend in Docker.)
BACKEND_PORT=8000
# Where the server keeps accounts, uploaded CVs and run logs. Leave unset for the
# repo defaults (knowledge_base/auth, uploads, logs/frontend_runs). scripts/dev.py
# smoke sets all three to a temp folder for the server it starts itself.
# KB_AUTH_DIR=
# CV_UPLOADS_DIR=
# RUNS_DIR=
# Bootstrap admin credential for scripts/frontend_api.py. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = nobody can administer the bridge: no access request can be approved,
# so no user token can ever be issued.
ADMIN_TOKEN=
# Pipeline runs granted per issued user token (admin is never decremented).
DEFAULT_RUN_ALLOWANCE=2
# The CV PDF every UI run starts from, until CV upload exists. Empty = knowledge_base/input/CV_test.pdf.
# A run fails at the cv_link node if this file is missing.
CV_DEFAULT_PATH=
# Cache the Document planner's answer on disk (logs/plan_cache/), keyed by the exact call, so the
# same inputs never pay for LLM call 1 twice. 0 = call the model every time.
PLAN_CACHE=1
